# ---- LLM (default: local Ollama, no key required) ----
LLM_PROVIDER=ollama                 # ollama | anthropic | openai | azure | local
# `ollama_chat/<name>` uses Ollama's /api/chat (multi-message support).
# Switch to `openai/gpt-4o-mini` or `anthropic/claude-3-5-sonnet-latest`
# (and set the matching API key below) to run against a hosted provider.
LLM_MODEL=ollama_chat/qwen2.5-coder:7b
ROUTER_MODEL=ollama_chat/qwen2.5-coder:7b
OLLAMA_API_BASE=http://localhost:11434
# Set when LLM_MODEL points at a hosted provider. Empty for local Ollama.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Embedding ----
# Embeddings still run locally via sentence-transformers (no API). Set
# REPOSAGE_LLM_PROVIDER=mock to swap in HashEmbedder for offline tests.
EMBED_MODEL=BAAI/bge-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cpu                    # cpu | cuda | mps

# ---- Storage ----
SQLITE_PATH=./data/reposage.db
HNSW_DATA_DIR=./data/hnsw
BM25_INDEX_DIR=./data/bm25

# ---- HNSW ----
HNSW_GRPC_ADDR=localhost:50051
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=64

# ---- GitHub App ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=reposage
LOG_LEVEL=INFO
