# ---- LLM ----
LLM_PROVIDER=anthropic              # anthropic | openai | azure | local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Embedding ----
EMBED_MODEL=BAAI/bge-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cpu                    # cpu | cuda | mps

# ---- Storage ----
SQLITE_PATH=./data/reposage.db
HNSW_DATA_DIR=./data/hnsw
BM25_INDEX_DIR=./data/bm25

# ---- HNSW ----
HNSW_GRPC_ADDR=localhost:50051
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=64

# ---- GitHub App ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=reposage
LOG_LEVEL=INFO
